{
  "manifest_version": 3,
  "name": "SubClick — Instant Subtitle Translator",
  "short_name": "SubClick",
  "version": "1.0.0",
  "description": "Click any subtitle word on YouTube or Netflix to pause, view instant word & sentence translations, and save vocabulary.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "SubClick Subtitle Translator",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "src/content/netflix-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/translator.js",
        "src/content/tokenizer.js",
        "src/content/platforms.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
